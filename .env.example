# Spatial Furniture AI — Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# Do NOT commit actual secrets or API keys to version control.

# Google Gemini API Key (Server-Side Only)
# Used by /api/ai/visualize and /api/ai/recommendations via Google GenAI SDK.
# Must NOT have NEXT_PUBLIC_ prefix to prevent client-side bundle exposure.
GEMINI_API_KEY=your_gemini_api_key_here


# Firebase Web Client Configuration
# Public client credentials used by the Firebase JS SDK and server-side verification.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Application Base URL (Optional: defaults to window.location.origin in browser, or http://localhost:3000 in dev)
# In production, set to your canonical app URL (e.g., https://spatial-furniture-ai.web.app or https://yourdomain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Admin SDK Configuration (Server-Side Only — Free Spark Plan Compatible)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Keep private; never expose to client bundles or git.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Custom Email Dispatch via SMTP (Server-Side Only — 100% Free via Gmail SMTP)
# For Gmail: Use a free 16-character Google App Password (myaccount.google.com -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="Spatial Furniture AI" <your_email@gmail.com>

