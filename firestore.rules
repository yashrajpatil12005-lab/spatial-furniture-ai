rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is a retailer by reading their user document
    function isRetailer() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'retailer';
    }

    // Helper function to check if the user is an admin by reading their user document
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Match the users collection
    match /users/{userId} {
      // Allow read if the user is authenticated and is reading their own document, or if user is admin
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Allow create if the user is authenticated, creating their own document,
      // and the role is explicitly "customer" or "retailer".
      // They cannot create a document for another user or assign themselves admin.
      allow create: if isAuthenticated() 
                    && request.auth.uid == userId
                    && (request.resource.data.role == "customer" || request.resource.data.role == "retailer");
                    
      // Allow update if the user is authenticated and updating their own document,
      // BUT prevent them from changing their role.
      allow update: if isAuthenticated() 
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;

      // Disallow delete for client users
      allow delete: if false;
    }

    // Match the products collection
    match /products/{productId} {
      // Allow public read for product discovery and details
      allow read: if true;
      
      // Allow creation only if the user is a retailer and the retailerId matches their uid, or if user is admin
      allow create: if (isRetailer() && request.resource.data.retailerId == request.auth.uid) || isAdmin();
                    
      // Allow update only if the user is a retailer who owns the product, cannot transfer ownership, or if user is admin
      allow update: if (isRetailer() && resource.data.retailerId == request.auth.uid && request.resource.data.retailerId == resource.data.retailerId) || isAdmin();

      // Allow delete only if the user is a retailer and they own the product, or if user is admin
      allow delete: if (isRetailer() && resource.data.retailerId == request.auth.uid) || isAdmin();
    }
  }
}
