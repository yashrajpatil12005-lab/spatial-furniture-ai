
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isRetailer() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'retailer';
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && (request.resource.data.role == "customer" ||
            request.resource.data.role == "retailer");

      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // PRODUCTS
    match /products/{productId} {
      allow read: if true;

      allow create: if
        (isRetailer() &&
         request.resource.data.retailerId == request.auth.uid)
        || isAdmin();

      allow update: if
        (isRetailer() &&
         resource.data.retailerId == request.auth.uid &&
         request.resource.data.retailerId == resource.data.retailerId)
        || isAdmin();

      allow delete: if
        (isRetailer() &&
         resource.data.retailerId == request.auth.uid)
        || isAdmin();
    }

    // EMAIL RATE LIMITS
    match /email_rate_limits/{userId} {
      allow read, write: if false;
    }

    // CUSTOMER ROOM SCANS
    match /room_scans/{scanId} {

      // Customers can create only their own room scan records.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'customerId',
          'imagePath',
          'productId',
          'productName',
          'analysis',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'customerId',
          'imagePath',
          'productId',
          'productName',
          'analysis',
          'createdAt'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.imagePath is string
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.analysis is string
        && request.resource.data.createdAt is timestamp;

      // Customers see their own scans.
      // Retailers and admins can see all customer scans.
      allow read: if isAuthenticated() &&
        (
          resource.data.customerId == request.auth.uid ||
          isRetailer() ||
          isAdmin()
        );

      // No one can modify an existing scan.
      allow update: if false;

      // Customers can delete their own scans.
      // Admins can delete any scan.
      allow delete: if isAuthenticated() &&
        (
          resource.data.customerId == request.auth.uid ||
          isAdmin()
        );
    }
  }
}
