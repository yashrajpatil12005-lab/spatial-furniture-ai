rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is a retailer by reading their user document
    function isRetailer() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'retailer';
    }

    // Match the users collection
    match /users/{userId} {
      // Allow read if the user is authenticated and is reading their own document
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Allow create if the user is authenticated, creating their own document,
      // and the role is explicitly set to "customer". 
      // They cannot create a document for another user or assign themselves admin/retailer.
      allow create: if isAuthenticated() 
                    && request.auth.uid == userId
                    && request.resource.data.role == "customer";
                    
      // Allow update if the user is authenticated and updating their own document,
      // BUT prevent them from changing their role.
      allow update: if isAuthenticated() 
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;

      // Disallow delete for client users
      allow delete: if false;
    }

    // Match the products collection
    match /products/{productId} {
      // Allow any authenticated user (customer, retailer, admin) to read products
      allow read: if isAuthenticated();
      
      // Allow creation only if the user is a retailer and the retailerId matches their uid
      allow create: if isRetailer() 
                    && request.resource.data.retailerId == request.auth.uid;
                    
      // Allow update and delete only if the user is a retailer and they own the product
      allow update, delete: if isRetailer() 
                            && resource.data.retailerId == request.auth.uid;
    }
  }
}
